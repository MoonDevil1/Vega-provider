# Copy to .env to configure CLI WAF testing. Requires Node.js 20.12+.
# Leave empty to find installed Edge, then Chrome automatically.
VEGA_BROWSER_PATH=

# Use an absolute path to a Chromium browser executable (not its folder).
# Windows: use forward slashes, and quote paths containing spaces.
# VEGA_BROWSER_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"
# macOS:
# VEGA_BROWSER_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Linux:
# VEGA_BROWSER_PATH=/usr/bin/chromium
